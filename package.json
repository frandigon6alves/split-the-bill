  "version": "0.1.0",
  "description": "Split shared expenses in a group and settle up with as few payments as possible.",
  "license": "MIT",
  "author": "Franciellen Gonçalves",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
